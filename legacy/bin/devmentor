#!/usr/bin/env bash
# DevMentor - Java programming mentor
# Type devmentor in terminal to start, just like claude / qoder
set -euo pipefail

# --- 1. Locate JAR ---
if [[ -n "${DEVMENTOR_HOME:-}" ]]; then
    JAR_DIR="$DEVMENTOR_HOME/lib"
else
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    if [[ -f "$SCRIPT_DIR/../lib/devmentor.jar" ]]; then
        JAR_DIR="$SCRIPT_DIR/../lib"
    else
        JAR_DIR="$HOME/.devmentor/lib"
    fi
fi
JAR_PATH="$JAR_DIR/devmentor.jar"
if [[ ! -f "$JAR_PATH" ]]; then
    echo "Cannot find devmentor.jar. Run install.sh first." >&2
    exit 1
fi

# --- 2. Find Java 17+ ---
JAVA_EXE=""

# Prefer DEVMENTOR_JAVA_HOME
if [[ -n "${DEVMENTOR_JAVA_HOME:-}" ]] && [[ -x "$DEVMENTOR_JAVA_HOME/bin/java" ]]; then
    JAVA_EXE="$DEVMENTOR_JAVA_HOME/bin/java"
fi

# Fallback to JAVA_HOME (check version >= 17)
if [[ -z "$JAVA_EXE" ]] && [[ -n "${JAVA_HOME:-}" ]] && [[ -x "$JAVA_HOME/bin/java" ]]; then
    JV="$($JAVA_HOME/bin/java -version 2>&1 | head -1 | sed 's/.*"([0-9]+).*/\1/')"
    if [[ "$JV" -ge 17 ]] 2>/dev/null; then
        JAVA_EXE="$JAVA_HOME/bin/java"
    fi
fi

# Fallback to scan ~/.jdks
if [[ -z "$JAVA_EXE" ]] && [[ -d "$HOME/.jdks" ]]; then
    for d in $HOME/.jdks/openjdk-17* $HOME/.jdks/openjdk-2* $HOME/.jdks/jdk-17* $HOME/.jdks/jdk-2*; do
        if [[ -x "$d/bin/java" ]] && [[ -z "$JAVA_EXE" ]]; then
            JAVA_EXE="$d/bin/java"
        fi
    done
fi

# Fallback to java in PATH
if [[ -z "$JAVA_EXE" ]] && command -v java &>/dev/null; then
    JAVA_EXE="java"
fi

if [[ -z "$JAVA_EXE" ]]; then
    echo "Cannot find Java 17+. Install JDK 17 or set DEVMENTOR_JAVA_HOME." >&2
    echo "  Download: https://adoptium.net/" >&2
    exit 2
fi

# --- 3. Launch ---
exec "$JAVA_EXE" -jar "$JAR_PATH" "$@"
